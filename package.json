{
  "name": "clavarium-parley",
  "version": "0.8.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A bridge between a command-line agent and a screen of its own: a command and an MCP server of five verbs, and a small library that shows the exchange.",
  "bin": {
    "parley": "bin/parley.mjs",
    "parley-mcp": "server/parley-mcp.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "host/",
    "ui/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./host": "./host/parley-host.mjs",
    "./ui": "./ui/parley-ui.js",
    "./ui.css": "./ui/parley-ui.css",
    "./ui/texts/*": "./ui/texts/*",
    "./server": "./server/parley-mcp.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm run check:hooks && npm run check:shapes && npm run check:names && npm run check:shell && npm test",
    "check:shapes": "node tools/check-shapes.mjs",
    "check:names": "node tools/check-ai-names.mjs",
    "check:shell": "node tools/check-shell.mjs",
    "check:hooks": "node tools/check-hooks.mjs",
    "hooks": "git config core.hooksPath hooks"
  },
  "engines": {
    "node": ">=22"
  }
}
